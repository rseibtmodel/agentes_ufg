# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - DISCORD AI BOT & GOOGLE CALENDAR
# ==============================================================================
# Copie este arquivo para .env na mesma pasta (ou edite o existente):
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DISCORD BOT CREDENTIALS
# ------------------------------------------------------------------------------
# Token secreto do bot gerado no Discord Developer Portal
# https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=seu_token_do_discord_aqui

# (Opcional) ID numérico do usuário do Discord para restringir quem pode usar o bot
# Deixe em branco ou comente para permitir que qualquer usuário converse com o bot
DISCORD_USER=

# ------------------------------------------------------------------------------
# 2. MODELO DE LINGUAGEM (LLM / LM STUDIO)
# ------------------------------------------------------------------------------
# URL base da API OpenAI-compatível exposta pelo LM Studio ou vLLM/Ollama
LM_STUDIO_URL=http://localhost:1234/v1

# Chave de API (geralmente arbitrária no LM Studio local)
LM_STUDIO_API_KEY=lm-studio

# Identificador do modelo carregado no LM Studio
MODELO_LLM=qwen/qwen3.5-9b

# Temperatura de amostragem da LLM (0.0 mais determinístico, 1.0 mais criativo)
LLM_TEMPERATURE=0.7

# Tempo limite em segundos para aguardar a resposta da LLM
LLM_TIMEOUT_SECONDS=60.0

# ------------------------------------------------------------------------------
# 2.1 ROTEAMENTO HÍBRIDO & GOOGLE GEMINI API
# ------------------------------------------------------------------------------
# Provedor inicial padrão: local, google, gemini-pro ou auto
DEFAULT_LLM_PROVIDER=local

# Chave de API do Google Gemini (obtenha gratuitamente em https://aistudio.google.com/)
# Você também pode cadastrar diretamente pelo chat do Discord com: !modelo key <sua_chave>
GEMINI_API_KEY=

# Modelos do Google Gemini (ex: gemini-3.5-flash, gemini-3.5-flash-lite)
GEMINI_FLASH_MODEL=gemini-3.5-flash
GEMINI_PRO_MODEL=gemini-3.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Failover de Alta Disponibilidade (redireciona para Gemini se o LM Studio local falhar ou demorar)
ENABLE_AUTO_FAILOVER=true
LOCAL_TIMEOUT_FAILOVER_SECONDS=15.0

# ------------------------------------------------------------------------------
# 3. EMBEDDINGS & MEMÓRIA VETORIAL (CHROMADB + RAG)
# ------------------------------------------------------------------------------
# URL do endpoint de embeddings (se estiver na mesma instância do LM Studio)
LM_STUDIO_EMBEDDING_URL=http://localhost:1234/v1

# Modelo de embedding carregado no LM Studio
LM_STUDIO_EMBEDDING_MODEL=text-embedding-qwen3-embedding-4b

# Diretório onde o ChromaDB persistirá os índices e vetores de memória
# Padrão: discord/chroma_db
CHROMA_DIR=

# Quantidade de memórias relevantes recuperadas via busca semântica (RAG)
RAG_TOP_K=3

# ------------------------------------------------------------------------------
# 4. BANCO DE DADOS RELACIONAL (SQLITE)
# ------------------------------------------------------------------------------
# Caminho para o banco de dados SQLite onde histórico de chat é salvo
# Padrão: discord/chat_memory.db
DB_FILE=

# ------------------------------------------------------------------------------
# 5. PREFIXO DE COMANDOS E LIMITES OPERACIONAIS
# ------------------------------------------------------------------------------
# Prefixo para disparar comandos embutidos (ex: !ajuda, !pdfs, !agenda)
COMMAND_PREFIX=!

# Número máximo de rodadas consecutivas de chamadas de ferramentas pela LLM
MAX_TOOL_CALL_ITERATIONS=5

# Limite padrão de mensagens anteriores carregadas para o contexto da LLM
HISTORICO_LIMITE_PADRAO=10

# ------------------------------------------------------------------------------
# 6. GOOGLE CALENDAR (INTEGRAÇÃO DE AGENDA)
# ------------------------------------------------------------------------------
# Caminho para o arquivo credentials.json baixado do Google Cloud Console
# Padrão: discord/credentials.json
GOOGLE_CREDENTIALS_FILE=

# Caminho para o token.json gerado pelo script auth_calendar.py
# Padrão: discord/token.json
GOOGLE_TOKEN_FILE=

# Fuso horário padrão utilizado para interpretar datas e horários dos compromissos
CALENDAR_DEFAULT_TIMEZONE=America/Sao_Paulo

# ------------------------------------------------------------------------------
# 7. PROMPT DO SISTEMA (SYSTEM PROMPT)
# ------------------------------------------------------------------------------
# Personalize a personalidade, diretrizes ou restrições do bot (opcional)
SYSTEM_PROMPT="Você é um assistente pessoal prestativo respondendo via Discord. Lembre-se do contexto da conversa. Você tem acesso a ferramentas para gerenciar PDFs, gerenciar sua agenda do Google Calendar, consultar memórias antigas, criar e controlar listas de mercado/tarefas e agendar lembretes automáticos. Gere respostas curtas, objetivas e de bom humor."

# ------------------------------------------------------------------------------
# 8. FILTRAGEM SEMÂNTICA DE FERRAMENTAS (TOOL RAG / DYNAMIC TOOL SELECTION)
# ------------------------------------------------------------------------------
# Ativa seleção dinâmica de ferramentas por similaridade de embeddings com a mensagem do usuário
TOOL_FILTER_ENABLED=true

# Número máximo de ferramentas mais relevantes enviadas para a LLM
TOOL_FILTER_TOP_K=5

# Pontuação mínima de similaridade de cosseno (0.0 a 1.0) para incluir a ferramenta
TOOL_FILTER_MIN_SIMILARITY=0.20

# ------------------------------------------------------------------------------
# 9. TRANSCRIÇÃO DE ÁUDIO (FASTER-WHISPER PT-BR)
# ------------------------------------------------------------------------------
# Tamanho do modelo Whisper: tiny, base, small, medium, large-v3 (recomendado: base)
WHISPER_MODEL_SIZE=base

# Idioma da transcrição (pt para português do Brasil)
WHISPER_LANGUAGE=pt

# Dispositivo de execução (cpu no Mac Apple Silicon / int8)
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ------------------------------------------------------------------------------
# 10. SÍNTESE DE VOZ E RESPOSTA EM ÁUDIO (EDGE-TTS PT-BR)
# ------------------------------------------------------------------------------
# Habilita síntese de voz para respostas em áudio
TTS_ENABLED=true

# Voz padrão do edge-tts: Francisca Brasil (pt-BR-FranciscaNeural)
TTS_VOICE=pt-BR-FranciscaNeural

# Modo de resposta padrão: texto (apenas texto), audio (apenas áudio), ambos (texto e áudio)
TTS_DEFAULT_MODE=texto

# ------------------------------------------------------------------------------
# 11. PESQUISA NA WEB EM TEMPO REAL & BROWSING (DUCKDUCKGO / TAVILY / SEARXNG)
# ------------------------------------------------------------------------------
# Habilita ferramentas de busca na internet e extração de conteúdo de páginas
WEB_SEARCH_ENABLED=true

# Provedor padrão: duckduckgo (gratuito e sem chave), tavily ou searxng
WEB_SEARCH_PROVIDER=duckduckgo

# Número máximo de resultados retornados por busca
WEB_SEARCH_MAX_RESULTS=4

# Tempo limite em segundos para requisições na web
WEB_SEARCH_TIMEOUT=12.0

# (Opcional) Chave de API do Tavily (https://tavily.com) para buscas profundas
TAVILY_API_KEY=

# (Opcional) URL base de uma instância privada do SearXNG
SEARXNG_URL=

# ------------------------------------------------------------------------------
# 12. BARRAMENTO CENTRAL DE MENSAGENS & OUTBOX ANTI-SPAM (IDEA-24)
# ------------------------------------------------------------------------------
# Habilita o canal único de envio e controle centralizado de cadência
MESSAGE_GATEWAY_ENABLED=true

# Intervalo do Leaky Bucket (segundos entre despachos de background no mesmo canal)
GATEWAY_LEAKY_BUCKET_INTERVAL_SEC=1.5

# Janela deslizante de deduplicação por hash SHA-256 (em segundos)
GATEWAY_DEBOUNCE_WINDOW_SEC=60

# Limiar do Circuit Breaker: máximo de mensagens por canal em 10 segundos
GATEWAY_CIRCUIT_BREAKER_MAX_MSGS=8
GATEWAY_CIRCUIT_BREAKER_COOLDOWN_SEC=30

# Persistência de mensagens na tabela SQLite outbox_queue
GATEWAY_PERSISTENCE_ENABLED=true

# ------------------------------------------------------------------------------
# 13. INTERFACE INTERATIVA COM BOTÕES, MENUS E MODAIS (IDEA-08)
# ------------------------------------------------------------------------------
# Habilita componentes de Discord UI (discord.ui.View, Button, SelectMenu, Modal)
DISCORD_UI_COMPONENTS_ENABLED=true

# Tempo limite em segundos para interação dos botões antes de desativarem
DISCORD_UI_TIMEOUT_SECONDS=180


